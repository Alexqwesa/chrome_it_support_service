# Chrome IT Support Service environment example
#
# Loading order:
#   1. .env.example
#   2. .env
#   3. real process environment variables
#
# Copy this file to .env and change the production section first.

# ============================================================
# Production values to change
# ============================================================

# Required. Low-privilege token used by Windows agents to register.
# Generate a long random token and use the same value when building clients.
AGENT_ENROLLMENT_TOKEN=replace-with-a-separate-long-random-token

# Public URL used by Windows clients. Nginx listens on HTTPS port 9999.
RELAY_SERVER_URL=https://softapp.vietsov.com.vn:9999

# Link shown on /debug-sessions for users to download the Windows agent.
CLIENT_DOWNLOAD_URL=/download/client_debug_agent.exe

# SSH target copied into the web session list.
SSH_RELAY_HOST=debug-tunnel@softapp.vietsov.com.vn
SSH_RELAY_PORT=2223

# Docker SSH relay inputs.
SSH_RELAY_PUBLISH_BIND=0.0.0.0
SSH_AUTHORIZED_KEYS_DIR=./deploy

# Optional. Set only if you want the disconnect button/admin mutation endpoint.
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=replace-with-a-long-random-password

# Admin key manager. Docker Compose overrides these to container paths.
AUTHORIZED_KEYS_FILE=deploy/authorized_keys
# SSHD_RELOAD_SIGNAL_FILE=deploy/reload-sshd

# ============================================================
# Safe defaults
# ============================================================

# Read-only list is visible without Basic auth. Protect it with LAN/VPN/nginx
# allow rules instead. Set true only if you want Basic auth for list endpoints.
SESSION_LIST_REQUIRES_AUTH=false

# Dart backend HTTP port. Keep this different from nginx public HTTPS port 9999
# when nginx and the Dart relay run on the same host.
SERVER_HTTP_PORT=9998
SERVER_HTTP_BIND=0.0.0.0

# Docker host publishing for the Dart backend. Keep loopback-only when nginx is
# the public frontend.
SERVER_HTTP_PUBLISH_BIND=127.0.0.1
SERVER_HTTP_PUBLISH_PORT=9998

# Server-local tunnel ports. Docker publishes these only on 127.0.0.1.
SERVER_TUNNEL_BIND=0.0.0.0
SERVER_PORT_START=41000
SERVER_PORT_END=41049

# Session lifecycle.
HEARTBEAT_TIMEOUT_SECONDS=60
SESSION_TIMEOUT_SECONDS=28800

# Windows client build/runtime metadata.
AGENT_VERSION=1.0.0
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# ============================================================
# Configuration reference
# ============================================================
#
# Variable                    Component  Default / example                         Purpose
# ADMIN_USERNAME              server     admin                                     Basic-auth username for admin actions
# ADMIN_PASSWORD              server     optional                                  Enables protected admin actions: SSH key management and disconnect
# AUTHORIZED_KEYS_FILE        server     deploy/authorized_keys                    authorized_keys file edited by /admin/keys
# SSHD_RELOAD_SIGNAL_FILE     server     optional                                  Marker file written by the sshd reload button
# SESSION_LIST_REQUIRES_AUTH  server     false                                     Require Basic auth for GET /debug-sessions and GET /api/sessions
# AGENT_ENROLLMENT_TOKEN      both       required                                  Agent WebSocket bearer token
# SERVER_HTTP_PORT            server     9998                                      Dart HTTP/WebSocket backend listener port
# SERVER_HTTP_BIND            server     0.0.0.0                                   Dart HTTP listener address
# SERVER_HTTP_PUBLISH_BIND    compose    127.0.0.1                                 Host bind address for backend HTTP publish
# SERVER_HTTP_PUBLISH_PORT    compose    9998                                      Host port for backend HTTP publish
# SERVER_TUNNEL_BIND          server     0.0.0.0 in Docker                         Relay listener address inside container
# SERVER_PORT_START           server     41000                                     First server-local relay port
# SERVER_PORT_END             server     41049                                     Last server-local relay port
# SSH_RELAY_HOST              server     debug-tunnel@softapp.vietsov.com.vn       SSH target shown in copied commands
# SSH_RELAY_PORT              server     2223                                      SSH port shown in copied commands
# SSH_RELAY_PUBLISH_BIND      compose    0.0.0.0                                   Host bind address for ssh-relay
# SSH_AUTHORIZED_KEYS_DIR     compose    ./deploy                                  Mounted directory containing authorized_keys
# HEARTBEAT_TIMEOUT_SECONDS   server     60                                        Stale-agent timeout
# SESSION_TIMEOUT_SECONDS     server     28800                                     Maximum session lifetime
# RELAY_SERVER_URL            client     https://softapp.vietsov.com.vn:9999       Public relay URL, normally HTTPS
# CLIENT_DOWNLOAD_URL         server     /download/client_debug_agent.exe          Link shown on the session page
# CHROME_PATH                 client     auto-detected                             Optional full path to Chrome
# AGENT_VERSION               client     1.0.0                                     Version shown in logs

