# Server variables used by docker compose
ADMIN_USERNAME=admin
# Optional. Required only for protected admin actions such as disconnect.
# ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_LIST_REQUIRES_AUTH=false
AGENT_ENROLLMENT_TOKEN=replace-with-a-separate-long-random-token
SERVER_HTTP_PORT=8080
SERVER_HTTP_BIND=0.0.0.0
SERVER_TUNNEL_BIND=0.0.0.0
SERVER_HTTP_PUBLISH_BIND=0.0.0.0
SERVER_PORT_START=41000
SERVER_PORT_END=41049
OPERATOR_SSH_HOST=vsp-debug
HEARTBEAT_TIMEOUT_SECONDS=60
SESSION_TIMEOUT_SECONDS=28800

# Windows client variables (set these in the shell or a launch script)
RELAY_SERVER_URL=https://debug.example.com
AGENT_VERSION=1.0.0
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
