server {
    listen 9999 ssl http2;
    server_name softapp.vietsov.com.vn;

    # ssl_certificate /etc/letsencrypt/live/softapp.vietsov.com.vn/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/softapp.vietsov.com.vn/privkey.pem;
       ssl_certificate      ssl/certificate.pem;
       ssl_certificate_key  ssl/privatekey.pem;

    # Agent authentication is handled by AGENT_ENROLLMENT_TOKEN.
    location = /agent {
        proxy_pass http://127.0.0.1:9998/agent;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Host $host;
        proxy_read_timeout 9h;
        proxy_send_timeout 9h;
    }

    location = /health {
        proxy_pass http://127.0.0.1:9998/health;
    }

    root html/chrome-debug-relay;
    # Windows user agent download.
    location = /download/client_debug_agent.exe {

        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        deny all;

        # if no download dir use:
        #alias html/chrome-debug-relay/client_debug_agent.exe;

        default_type application/octet-stream;
        add_header Content-Disposition 'attachment; filename="client_debug_agent.exe"';
    }

    # Read-only connection list for the local network.
    location = /debug-sessions {
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        deny all;

        proxy_pass http://127.0.0.1:9998/debug-sessions;
        proxy_set_header Host $host;
    }

    location = /api/sessions {
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        deny all;

        proxy_pass http://127.0.0.1:9998/api/sessions;
        proxy_set_header Host $host;
    }

    # Admin pages and mutation endpoints. Password checks are handled by the
    # Dart server through ADMIN_PASSWORD, not by nginx.
    location /admin/ {
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        deny all;

        proxy_pass http://127.0.0.1:9998;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Host $host;
    }

    location ~ ^/api/sessions/[^/]+/disconnect$ {
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        deny all;

        proxy_pass http://127.0.0.1:9998;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Host $host;
    }

    location = / {
        return 302 /debug-sessions;
    }

    location / {
        return 404;
    }
}
