server {
    listen 443 ssl http2;
    server_name debug.example.com;

    ssl_certificate /etc/letsencrypt/live/debug.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/debug.example.com/privkey.pem;

    # Agent authentication is handled by AGENT_ENROLLMENT_TOKEN.
    location = /agent {
        proxy_pass http://127.0.0.1:8080/agent;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Host $host;
        proxy_read_timeout 9h;
        proxy_send_timeout 9h;
    }

    location = /health {
        proxy_pass http://127.0.0.1:8080/health;
    }

    # Keep this restricted to the IT VPN/network. The relay also verifies the
    # same Basic credentials through ADMIN_USERNAME and ADMIN_PASSWORD.
    location / {
        allow 10.0.0.0/8;
        allow 192.168.0.0/16;
        deny all;

        auth_basic "Chrome debug relay";
        auth_basic_user_file /etc/nginx/.htpasswd-debug-relay;

        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Host $host;
    }
}
